{% extends "layout.twig" %}
{% block title %}Books · {{ app.name }}{% endblock %}

{% block content %}
  {% set isMine = (mode ?? 'browse') == 'mine' %}

  <div class="page-head d-flex align-items-start justify-content-between gap-3 mb-3">
    <div>
      <h1 class="h4 mb-1">{{ isMine ? 'My books' : 'Books' }}</h1>
      <div class="text-muted small">{{ isMine ? 'Manage only your own books (edit/delete).' : 'Public catalog (read/search for everyone).' }}</div>
    </div>
    {% if auth.user %}
      <a class="btn btn-primary" href="{{ app.base_url }}/books/new">Add book</a>
    {% endif %}
  </div>

  <div class="card shadow-sm mb-3">
    <div class="card-body">
      <form class="row g-3" method="get" action="{{ action ?? (app.base_url ~ '/books') }}">
        <div class="col-md-6 typeahead">
          <label class="form-label">Title</label>
          <input name="title" value="{{ filters.title }}" class="form-control" placeholder="e.g. Dune" data-suggest-field="title" data-suggest-list="titleList" data-suggest-mine="{{ isMine ? '1' : '0' }}" autocomplete="off">
          <div id="titleList" class="typeahead-list d-none"></div>
        </div>
        <div class="col-md-6 typeahead">
          <label class="form-label">Author</label>
          <input name="author" value="{{ filters.author }}" class="form-control" placeholder="e.g. Frank Herbert" data-suggest-field="author" data-suggest-list="authorList" data-suggest-mine="{{ isMine ? '1' : '0' }}" autocomplete="off">
          <div id="authorList" class="typeahead-list d-none"></div>
        </div>
        <div class="col-md-4 typeahead">
          <label class="form-label">Genre</label>
          <input name="genre" value="{{ filters.genre }}" class="form-control" placeholder="e.g. Sci-Fi" data-suggest-field="genre" data-suggest-list="genreList" data-suggest-mine="{{ isMine ? '1' : '0' }}" autocomplete="off">
          <div id="genreList" class="typeahead-list d-none"></div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Published year</label>
          <input name="year" value="{{ filters.year }}" class="form-control" type="number" min="1000" max="2100" placeholder="e.g. 2023">
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
          <button class="btn btn-soft w-100" type="submit">Search</button>
          <a class="btn btn-outline-secondary" href="{{ action ?? (app.base_url ~ '/books') }}">Reset</a>
        </div>
      </form>
    </div>
  </div>

  {% if books|length %}
    <div class="book-grid">
      {% for b in books %}
        <div class="card book-card">
          <div class="card-body d-flex flex-column gap-2">
            <div class="d-flex align-items-start justify-content-between gap-2">
              <div class="flex-grow-1">
                <a class="book-title" href="{{ app.base_url }}/books/{{ b.id }}">{{ b.title }}</a>
                <div class="book-meta small mt-1">{{ b.author }} · {{ b.genre }} · {{ b.published_year }}</div>
              </div>
              <div class="text-end">
                <span class="badge-soft">{{ b.owner_username ?: '—' }}</span>
              </div>
            </div>

            <div class="book-actions d-flex gap-2 flex-wrap pt-1">
              <a class="btn btn-sm btn-soft" href="{{ app.base_url }}/books/{{ b.id }}">View</a>
              {% if b.can_edit %}
                <a class="btn btn-sm btn-outline-primary" href="{{ app.base_url }}/books/{{ b.id }}/edit">Edit</a>
                <form method="post" action="{{ app.base_url }}/books/{{ b.id }}/delete" class="d-inline" onsubmit="return confirm('Delete this book?')">
                  {{ csrf_field() }}
                  <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="app-empty card shadow-sm">
      <div class="card-body">
        <div class="app-empty-icon" aria-hidden="true">0</div>
        <h2 class="h6 mb-2">No results</h2>
        <div class="text-muted mb-3">Try adjusting filters, or reset and search again.</div>
        <a class="btn btn-soft" href="{{ action ?? (app.base_url ~ '/books') }}">Reset filters</a>
      </div>
    </div>
  {% endif %}
{% endblock %}
