{% extends "layout.twig" %}
{% block title %}Login · {{ app.name }}{% endblock %}
{% block body_class %}auth-bg{% endblock %}
{% block main_class %}auth-main{% endblock %}


{% block content %}
  <div class="card shadow-lg auth-card">
    <div class="card-body">
      <div class="text-center mb-4">
        <div class="app-auth-badge mb-3">{{ app.name }}</div>
        <h1 class="h4 mb-1">Welcome back</h1>
        <div class="text-muted small">Sign in to browse and manage your books.</div>
      </div>
      <form method="post" action="{{ app.base_url }}/login" class="vstack gap-3">
        {{ csrf_field() }}
        <div>
          <label class="form-label">Username</label>
          <input name="username" class="form-control" autocomplete="username" required>
        </div>
        <div>
          <label class="form-label">Password</label>
          <input name="password" type="password" class="form-control" autocomplete="current-password" required>
        </div>
        <div>
          <label class="form-label">Captcha: {{ captcha_question() }}</label>
          <input name="captcha" class="form-control" inputmode="numeric" required>
          <div class="form-text">This prevents automated attacks (captcha requirement).</div>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary" type="submit">Login</button>
          <a class="btn btn-soft" href="{{ app.base_url }}/register">Create account</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

